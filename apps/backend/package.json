{
  "name": "@thinkink/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {},
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --inspector-ip 127.0.0.1 --inspector-port 9230",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "preview": "wrangler dev dist/index.js --no-bundle --local --ip 127.0.0.1 --port 4173 --inspector-ip 127.0.0.1 --inspector-port 9231",
    "types": "node -e \"require('node:fs').mkdirSync('.generated', {recursive: true})\" && wrangler types .generated/worker.d.ts",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:rooms": "vitest run --config vitest.rooms.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@thinkink/shared": "0.1.0",
    "htmlparser2": "12.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
